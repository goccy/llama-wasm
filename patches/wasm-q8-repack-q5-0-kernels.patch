+// Q5_0 repacked eight rows wide (the wasm build's prompt-path layout for
+// Q5_0 tensors; a wasm-to-native transpiler substitutes native GEMV/GEMM
+// bodies for the exported kernels). qs interleaves the eight rows'
+// nibble bytes in 8-byte groups exactly like block_q4_0x8 (group i holds
+// bytes 8*(i/8).. of row i%8; a byte carries element j in its low nibble
+// and element j+16 in its high nibble), without the sign xor: nibbles
+// stay 0..15 and the fifth bit adds 16, the -16 offset is applied by the
+// kernels. qh stores the fifth bits per 16-byte group m (= groups 2m,
+// 2m+1): qh[4m+0], qh[4m+1] are the bits of the two rows' low-nibble
+// elements 8*(m/4)..+8, qh[4m+2], qh[4m+3] those of the high-nibble
+// elements 16 later.
+struct block_q5_0x8 {
+    ggml_half d[8];
+    uint8_t   qh[32];
+    uint8_t   qs[128];
+};
+static_assert(sizeof(block_q5_0x8) == 8 * sizeof(ggml_half) + 32 + 128, "wrong q5_0x8 block size/padding");
