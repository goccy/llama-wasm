+// Q5_0 -> block_q5_0x8 (see repack.h for the layout).
+static block_q5_0x8 make_block_q5_0x8(const block_q5_0 * in) {
+    block_q5_0x8 out;
+    for (int i = 0; i < 8; i++) {
+        out.d[i] = in[i].d;
+    }
+    for (int i = 0; i < 16; i++) {
+        memcpy(&out.qs[8 * i], &in[i % 8].qs[(i / 8) * 8], 8);
+    }
+    for (int m = 0; m < 8; m++) {
+        const int c0 = 2 * (m % 4);
+        const int b  = m / 4;
+        out.qh[4 * m + 0] = in[c0].qh[b];
+        out.qh[4 * m + 1] = in[c0 + 1].qh[b];
+        out.qh[4 * m + 2] = in[c0].qh[2 + b];
+        out.qh[4 * m + 3] = in[c0 + 1].qh[2 + b];
+    }
+    return out;
+}
