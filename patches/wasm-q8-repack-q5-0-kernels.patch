+// The 8-wide interleave of the same quantizer, feeding the x8 repack
+// GEMMs (q4_0, q5_0, iq4_nl): qs[32k + 8m] holds eight consecutive
+// elements of row m. It must quantize exactly like quantize_row_q8_0,
+// which feeds the GEMV path of the same tensors (ggml quantizes full
+// 4-row groups here and the remaining rows there), so it rounds to
+// nearest even as that function and every native SIMD quantizer do;
+// the generic body's roundf rounds ties away and would make a batch
+// decode differ from a sequential one. Exported so a wasm-to-native
+// transpiler can substitute a native body.
+__attribute__((noinline, export_name("dbg_quantize_mat_q8_0_4x8")))
+void ggml_quantize_mat_q8_0_4x8(const float * GGML_RESTRICT x, void * GGML_RESTRICT vy, int64_t k) {
+    assert(QK8_0 == 32);
+    assert(k % QK8_0 == 0);
+    const int nb = k / QK8_0;
+
+    block_q8_0x4 * GGML_RESTRICT y = (block_q8_0x4 *) vy;
+
+#if defined(__wasm_simd128__)
+    v128_t srcv[4][8];
+    float  id[4];
+
+    for (int i = 0; i < nb; i++) {
+        for (int row_iter = 0; row_iter < 4; row_iter++) {
+            const float * GGML_RESTRICT xr = x + row_iter * k + i * QK8_0;
+            for (int j = 0; j < 8; j++) srcv[row_iter][j] = wasm_v128_load(xr + 4 * j);
+
+            v128_t amaxv[4];
+            for (int j = 0; j < 4; j++) {
+                amaxv[j] = wasm_f32x4_max(wasm_f32x4_abs(srcv[row_iter][2 * j]),
+                                          wasm_f32x4_abs(srcv[row_iter][2 * j + 1]));
+            }
+            amaxv[0] = wasm_f32x4_max(amaxv[0], amaxv[1]);
+            amaxv[2] = wasm_f32x4_max(amaxv[2], amaxv[3]);
+            amaxv[0] = wasm_f32x4_max(amaxv[0], amaxv[2]);
+
+            const float amax = MAX(MAX(wasm_f32x4_extract_lane(amaxv[0], 0),
+                                       wasm_f32x4_extract_lane(amaxv[0], 1)),
+                                   MAX(wasm_f32x4_extract_lane(amaxv[0], 2),
+                                       wasm_f32x4_extract_lane(amaxv[0], 3)));
+
+            const float d = amax / ((1 << 7) - 1);
+            id[row_iter] = d ? 1.0f / d : 0.0f;
+
+            y[i].d[row_iter] = GGML_CPU_FP32_TO_FP16(d);
+        }
+
+        for (int j = 0; j < 4; j++) {
+            v128_t r[4];
+            for (int m = 0; m < 4; m++) {
+                const v128_t idm = wasm_f32x4_splat(id[m]);
+                const v128_t lo = wasm_i32x4_trunc_sat_f32x4(wasm_f32x4_nearest(wasm_f32x4_mul(srcv[m][2 * j], idm)));
+                const v128_t hi = wasm_i32x4_trunc_sat_f32x4(wasm_f32x4_nearest(wasm_f32x4_mul(srcv[m][2 * j + 1], idm)));
+                // |q| <= 127, so the saturating packs are exact: eight
+                // consecutive elements of row m as i16.
+                r[m] = wasm_i16x8_narrow_i32x4(lo, hi);
+            }
+            // [row0 8B][row1 8B] then [row2 8B][row3 8B]: the 32-byte group j.
+            wasm_v128_store(y[i].qs + 32 * j,      wasm_i8x16_narrow_i16x8(r[0], r[1]));
+            wasm_v128_store(y[i].qs + 32 * j + 16, wasm_i8x16_narrow_i16x8(r[2], r[3]));
+        }
+    }
+#else
+    UNUSED(nb);
+    UNUSED(y);
+    ggml_quantize_mat_q8_0_4x8_generic(x, vy, k);
+#endif
+}
