+
+// Q5_0 8x8 repack GEMV/GEMM (block_q5_0x8 weights, see repack.h). These
+// scalar bodies are the definition on wasm; they are exported under
+// dbg_* names so a wasm-to-native transpiler can substitute native
+// bodies (noinline keeps the call sites calling them). The quant of
+// element e of column c is nibble | fifth bit << 4, and the -16 offset
+// is folded in through the activation block sum: sum((q-16)*a) =
+// sum(q*a) - 16*sum(a).
+static inline int q5_0x8_quant(const block_q5_0x8 * b, int c, int e) {
+    // group of the 8-byte run holding this element's byte
+    const int byte_in_col = e & 15;          // qs byte index within the column's 16
+    const int i           = (byte_in_col / 8) * 8 + c;
+    const int t           = byte_in_col & 7;
+    const uint8_t byte    = b->qs[8 * i + t];
+    const int m           = i / 2;
+    const int par         = i & 1;
+    const int nib         = (e < 16) ? (byte & 0x0F) : (byte >> 4);
+    const uint8_t qh      = (e < 16) ? b->qh[4 * m + par] : b->qh[4 * m + 2 + par];
+    return nib | (((qh >> t) & 1) << 4);
+}
+
+__attribute__((noinline, export_name("dbg_gemv_q5_0_8x8")))
+void ggml_gemv_q5_0_8x8_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                             const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int qk = QK8_0;
+    const int nb = n / qk;
+    assert(nr == 1);
+    assert(n % qk == 0);
+    assert(nc % 8 == 0);
+    UNUSED(bs);
+    UNUSED(nr);
+
+    const block_q8_0 * GGML_RESTRICT a_ptr = (const block_q8_0 *) vy;
+    for (int x = 0; x < nc / 8; x++) {
+        const block_q5_0x8 * GGML_RESTRICT b_ptr = (const block_q5_0x8 *) vx + (x * nb);
+        float sumf[8] = { 0 };
+        for (int l = 0; l < nb; l++) {
+            int asum = 0;
+            for (int e = 0; e < qk; e++) {
+                asum += a_ptr[l].qs[e];
+            }
+            const float da = GGML_CPU_FP16_TO_FP32(a_ptr[l].d);
+            for (int j = 0; j < 8; j++) {
+                int sumi = 0;
+                for (int e = 0; e < qk; e++) {
+                    sumi += q5_0x8_quant(&b_ptr[l], j, e) * a_ptr[l].qs[e];
+                }
+                sumf[j] += (float) (sumi - 16 * asum) * GGML_CPU_FP16_TO_FP32(b_ptr[l].d[j]) * da;
+            }
+        }
+        for (int j = 0; j < 8; j++) {
+            s[x * 8 + j] = sumf[j];
+        }
+    }
+}
+
+__attribute__((noinline, export_name("dbg_gemm_q5_0_8x8")))
+void ggml_gemm_q5_0_8x8_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                             const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int qk = QK8_0;
+    const int nb = n / qk;
+    assert(n % qk == 0);
+    assert(nr % 4 == 0);
+    assert(nc % 8 == 0);
+
+    for (int y = 0; y < nr / 4; y++) {
+        const block_q8_0x4 * GGML_RESTRICT a_ptr = (const block_q8_0x4 *) vy + (y * nb);
+        for (int x = 0; x < nc / 8; x++) {
+            const block_q5_0x8 * GGML_RESTRICT b_ptr = (const block_q5_0x8 *) vx + (x * nb);
+            float sumf[4][8] = { { 0 } };
+            for (int l = 0; l < nb; l++) {
+                for (int m = 0; m < 4; m++) {
+                    // row m's element e sits at qs[(e/8)*32 + m*8 + e%8]
+                    int asum = 0;
+                    for (int e = 0; e < qk; e++) {
+                        asum += a_ptr[l].qs[(e / 8) * 32 + m * 8 + (e % 8)];
+                    }
+                    const float da = GGML_CPU_FP16_TO_FP32(a_ptr[l].d[m]);
+                    for (int j = 0; j < 8; j++) {
+                        int sumi = 0;
+                        for (int e = 0; e < qk; e++) {
+                            sumi += q5_0x8_quant(&b_ptr[l], j, e) * a_ptr[l].qs[(e / 8) * 32 + m * 8 + (e % 8)];
+                        }
+                        sumf[m][j] += (float) (sumi - 16 * asum) * GGML_CPU_FP16_TO_FP32(b_ptr[l].d[j]) * da;
+                    }
+                }
+            }
+            for (int m = 0; m < 4; m++) {
+                for (int j = 0; j < 8; j++) {
+                    s[(y * 4 + m) * bs + x * 8 + j] = sumf[m][j];
+                }
+            }
+        }
+    }
+}
