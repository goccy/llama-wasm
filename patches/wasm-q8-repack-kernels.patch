diff --git a/ggml/src/ggml-cpu/arch/wasm/repack.cpp b/ggml/src/ggml-cpu/arch/wasm/repack.cpp
new file mode 100644
index 000000000..9db77fe9d
--- /dev/null
+++ b/ggml/src/ggml-cpu/arch/wasm/repack.cpp
@@ -0,0 +1,233 @@
+#define GGML_COMMON_IMPL_CPP
+#define GGML_COMMON_DECL_CPP
+#include "ggml-common.h"
+#include "ggml-backend-impl.h"
+
+#include "ggml-impl.h"
+#include "ggml-cpu.h"
+#include "ggml-cpu-impl.h"
+#include "simd-mappings.h"
+#include "traits.h"
+
+#include <cassert>
+
+#define GGML_CPU_CLANG_WORKAROUND
+#include "../../repack.h"
+
+#define UNUSED GGML_UNUSED
+
+#if defined(__wasm_simd128__)
+#include <wasm_simd128.h>
+
+// Combine the two dot accumulators of a 4-column interleaved group
+// into one per-column i32x4: dl carries column 0/1 partial pairs,
+// dh columns 2/3; even lanes + odd lanes = per-column sums.
+static inline v128_t repack_combine_cols(v128_t dl, v128_t dh) {
+    const v128_t even = wasm_i32x4_shuffle(dl, dh, 0, 2, 4, 6);
+    const v128_t odd  = wasm_i32x4_shuffle(dl, dh, 1, 3, 5, 7);
+    return wasm_i32x4_add(even, odd);
+}
+
+// Four consecutive f16 scales widened through the f32<-f16 lookup
+// table into one f32x4. The per-lane table build (and the scalar
+// table read for the activation scale) is deliberate: it is the
+// exact load/shift/load idiom the transpiler's kernel fusion
+// absorbs — the four-lane group collapses to a single native
+// half-to-float widen inside the fused region, with no vector
+// constants competing for argument registers.
+static inline v128_t repack_f16x4(const ggml_half * p) {
+    return wasm_f32x4_make(GGML_CPU_FP16_TO_FP32(p[0]),
+                           GGML_CPU_FP16_TO_FP32(p[1]),
+                           GGML_CPU_FP16_TO_FP32(p[2]),
+                           GGML_CPU_FP16_TO_FP32(p[3]));
+}
+
+// Per-block scale vector: the four interleaved columns' f16 scales
+// widened to f32 and pre-multiplied by the activation row's scale.
+static inline v128_t repack_scale_vec(const ggml_half * d, float da) {
+    return wasm_f32x4_mul(repack_f16x4(d), wasm_f32x4_splat(da));
+}
+#endif // __wasm_simd128__
+
+// Activation-side quantization for the q8_0x4 repack GEMM: four rows
+// of k floats become interleaved block_q8_0x4 blocks. The generic
+// version rounds each element through scalar roundf; this SIMD form
+// mirrors the NEON kernel — per-row 32-float abs/max reduction, one
+// f32x4 multiply per 4 elements, round-to-nearest-even (f32x4.nearest,
+// the rounding every native SIMD quantizer uses), and the 4-row group
+// interleave falls out of two narrowing packs: i32x4 -> i16x8 for row
+// pairs, then i16x8 -> i8x16 gives [row0 4B][row1 4B][row2 4B][row3
+// 4B] — exactly the 16-byte group layout — for ONE store per group.
+__attribute__((noinline))
+void ggml_quantize_mat_q8_0_4x4(const float * GGML_RESTRICT x, void * GGML_RESTRICT vy, int64_t k) {
+    assert(QK8_0 == 32);
+    assert(k % QK8_0 == 0);
+    const int nb = k / QK8_0;
+
+    block_q8_0x4 * GGML_RESTRICT y = (block_q8_0x4 *) vy;
+
+#if defined(__wasm_simd128__)
+    v128_t srcv[4][8];
+    float  id[4];
+
+    for (int i = 0; i < nb; i++) {
+        for (int row_iter = 0; row_iter < 4; row_iter++) {
+            const float * GGML_RESTRICT xr = x + row_iter * k + i * QK8_0;
+            for (int j = 0; j < 8; j++) srcv[row_iter][j] = wasm_v128_load(xr + 4 * j);
+
+            v128_t amaxv[4];
+            for (int j = 0; j < 4; j++) {
+                amaxv[j] = wasm_f32x4_max(wasm_f32x4_abs(srcv[row_iter][2 * j]),
+                                          wasm_f32x4_abs(srcv[row_iter][2 * j + 1]));
+            }
+            amaxv[0] = wasm_f32x4_max(amaxv[0], amaxv[1]);
+            amaxv[2] = wasm_f32x4_max(amaxv[2], amaxv[3]);
+            amaxv[0] = wasm_f32x4_max(amaxv[0], amaxv[2]);
+
+            const float amax = MAX(MAX(wasm_f32x4_extract_lane(amaxv[0], 0),
+                                       wasm_f32x4_extract_lane(amaxv[0], 1)),
+                                   MAX(wasm_f32x4_extract_lane(amaxv[0], 2),
+                                       wasm_f32x4_extract_lane(amaxv[0], 3)));
+
+            const float d = amax / ((1 << 7) - 1);
+            id[row_iter] = d ? 1.0f / d : 0.0f;
+
+            y[i].d[row_iter] = GGML_CPU_FP32_TO_FP16(d);
+        }
+
+        const v128_t id0 = wasm_f32x4_splat(id[0]);
+        const v128_t id1 = wasm_f32x4_splat(id[1]);
+        const v128_t id2 = wasm_f32x4_splat(id[2]);
+        const v128_t id3 = wasm_f32x4_splat(id[3]);
+        for (int j = 0; j < 8; j++) {
+            const v128_t v0 = wasm_i32x4_trunc_sat_f32x4(wasm_f32x4_nearest(wasm_f32x4_mul(srcv[0][j], id0)));
+            const v128_t v1 = wasm_i32x4_trunc_sat_f32x4(wasm_f32x4_nearest(wasm_f32x4_mul(srcv[1][j], id1)));
+            const v128_t v2 = wasm_i32x4_trunc_sat_f32x4(wasm_f32x4_nearest(wasm_f32x4_mul(srcv[2][j], id2)));
+            const v128_t v3 = wasm_i32x4_trunc_sat_f32x4(wasm_f32x4_nearest(wasm_f32x4_mul(srcv[3][j], id3)));
+            // |q| <= 127, so the saturating packs are exact.
+            const v128_t p01 = wasm_i16x8_narrow_i32x4(v0, v1);
+            const v128_t p23 = wasm_i16x8_narrow_i32x4(v2, v3);
+            wasm_v128_store(y[i].qs + 16 * j, wasm_i8x16_narrow_i16x8(p01, p23));
+        }
+    }
+#else
+    UNUSED(nb);
+    UNUSED(y);
+    ggml_quantize_mat_q8_0_4x4_generic(x, vy, k);
+#endif
+}
+
+// noinline: inlined into the mul_mat driver these bodies land in a
+// huge function where the transpiler's loop fusion cannot claim the
+// block loops; standalone they fuse like the vec_dot kernels.
+__attribute__((noinline, export_name("dbg_gemv_q8_0_4x4")))
+void ggml_gemv_q8_0_4x4_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                             const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int qk = QK8_0;
+    const int nb = n / qk;
+
+    assert(nr == 1);
+    assert(n % qk == 0);
+    assert(nc % 4 == 0);
+
+    UNUSED(bs);
+    UNUSED(nr);
+
+#if defined(__wasm_simd128__)
+    const block_q8_0 * GGML_RESTRICT a_ptr = (const block_q8_0 *) vy;
+    for (int x = 0; x < nc / 4; x++) {
+        const block_q8_0x4 * GGML_RESTRICT b_ptr = (const block_q8_0x4 *) vx + (x * nb);
+
+        v128_t sumv = wasm_f32x4_splat(0.0f);
+        // Pointer-bump countdown form: the block loop must reach the
+        // transpiler as a countdown over bumped pointers (index-form
+        // loops keep an up-counter for addressing and stay out of
+        // loop fusion). One 16-byte weight group per unrolled step,
+        // [col j][i 0..3]; the matching four activation bytes ride a
+        // broadcast so every column sees the same activation lane.
+        const block_q8_0x4 * GGML_RESTRICT bp = b_ptr;
+        const block_q8_0 * GGML_RESTRICT  ap = a_ptr;
+        for (int l = nb; l > 0; l--) {
+            v128_t acc_lo = wasm_i32x4_splat(0);
+            v128_t acc_hi = wasm_i32x4_splat(0);
+#pragma clang loop unroll(full)
+            for (int k = 0; k < 8; k++) {
+                const v128_t bg = wasm_v128_load(bp->qs + k * 16);
+                const v128_t ag = wasm_v128_load32_splat(ap->qs + k * 4);
+                acc_lo = wasm_i32x4_add(acc_lo, wasm_i32x4_dot_i16x8(wasm_i16x8_extend_low_i8x16(bg),
+                                                                     wasm_i16x8_extend_low_i8x16(ag)));
+                acc_hi = wasm_i32x4_add(acc_hi, wasm_i32x4_dot_i16x8(wasm_i16x8_extend_high_i8x16(bg),
+                                                                     wasm_i16x8_extend_high_i8x16(ag)));
+            }
+            const v128_t sums  = repack_combine_cols(acc_lo, acc_hi);
+            const v128_t scale = repack_scale_vec(bp->d, GGML_CPU_FP16_TO_FP32(ap->d));
+            sumv = wasm_f32x4_add(sumv, wasm_f32x4_mul(wasm_f32x4_convert_i32x4(sums), scale));
+            bp++;
+            ap++;
+        }
+        wasm_v128_store(s + x * 4, sumv);
+    }
+#else
+    ggml_gemv_q8_0_4x4_q8_0_generic(n, s, bs, vx, vy, nr, nc);
+#endif
+}
+
+__attribute__((noinline, export_name("dbg_gemm_q8_0_4x4")))
+void ggml_gemm_q8_0_4x4_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx,
+                             const void * GGML_RESTRICT vy, int nr, int nc) {
+    const int qk = QK8_0;
+    const int nb = n / qk;
+
+    assert(n % qk == 0);
+    assert(nr % 4 == 0);
+    assert(nc % 4 == 0);
+
+#if defined(__wasm_simd128__)
+    // ONE activation row per block loop, four passes per 4-row group
+    // — each pass is byte-for-byte the gemv block loop (the shape the
+    // transpiler's whole-loop fusion is proven to claim). The weight
+    // stream re-reads once per row; a column group's blocks fit in L1.
+    for (int y = 0; y < nr / 4; y++) {
+        const block_q8_0x4 * GGML_RESTRICT a_ptr = (const block_q8_0x4 *) vy + (y * nb);
+        for (int x = 0; x < nc / 4; x++) {
+            const block_q8_0x4 * GGML_RESTRICT b_ptr = (const block_q8_0x4 *) vx + (x * nb);
+#pragma clang loop unroll(full)
+            for (int row = 0; row < 4; row++) {
+                v128_t sumv = wasm_f32x4_splat(0.0f);
+                const block_q8_0x4 * GGML_RESTRICT bp = b_ptr;
+                const block_q8_0x4 * GGML_RESTRICT apb = a_ptr;
+                // Opaque per-pass pointers: without this clang CSEs
+                // address/scale subexpressions ACROSS the unrolled row
+                // passes, and a value shared between two block loops
+                // can be absorbed by neither (it stays a hoist-refusing
+                // intervener). Each pass must be self-contained for the
+                // transpiler's whole-loop fusion to claim it.
+                __asm__("" : "+r"(bp), "+r"(apb));
+                for (int l = nb; l > 0; l--) {
+                    v128_t acc_lo = wasm_i32x4_splat(0);
+                    v128_t acc_hi = wasm_i32x4_splat(0);
+#pragma clang loop unroll(full)
+                    for (int k = 0; k < 8; k++) {
+                        // One 16-byte weight group [col j][i 0..3]
+                        // against this row's 4-byte group.
+                        const v128_t b16 = wasm_v128_load(bp->qs + k * 16);
+                        const v128_t ag  = wasm_v128_load32_splat(apb->qs + k * 16 + row * 4);
+                        acc_lo = wasm_i32x4_add(acc_lo, wasm_i32x4_dot_i16x8(wasm_i16x8_extend_low_i8x16(b16),
+                                                                             wasm_i16x8_extend_low_i8x16(ag)));
+                        acc_hi = wasm_i32x4_add(acc_hi, wasm_i32x4_dot_i16x8(wasm_i16x8_extend_high_i8x16(b16),
+                                                                             wasm_i16x8_extend_high_i8x16(ag)));
+                    }
+                    const v128_t sums  = repack_combine_cols(acc_lo, acc_hi);
+                    const v128_t scale = repack_scale_vec(bp->d, GGML_CPU_FP16_TO_FP32(apb->d[row]));
+                    sumv = wasm_f32x4_add(sumv, wasm_f32x4_mul(wasm_f32x4_convert_i32x4(sums), scale));
+                    bp++;
+                    apb++;
+                }
+                wasm_v128_store(s + (y * 4 + row) * bs + x * 4, sumv);
+            }
+        }
+    }
+#else
+    ggml_gemm_q8_0_4x4_q8_0_generic(n, s, bs, vx, vy, nr, nc);
+#endif
+}
