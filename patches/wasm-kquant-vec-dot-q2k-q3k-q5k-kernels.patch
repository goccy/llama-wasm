@@ -768,9 +780,33 @@ void ggml_vec_dot_q4_K_q8_K_generic(int n, float * GGML_RESTRICT s, size_t bs, c
     *s = sumf;
 }
 
+#if defined(__wasm_simd128__)
+// On wasm this generic body IS the kernel (arch-fallback.h names it
+// ggml_vec_dot_q5_K_q8_K); exported out of line under a dbg_* name so a
+// wasm-to-native transpiler can substitute a native body.
+__attribute__((noinline, export_name("dbg_vec_dot_q5_K_q8_K")))
+#endif
 void ggml_vec_dot_q5_K_q8_K_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy,  size_t by, int nrc) {
     assert(n % QK_K == 0);
+#if defined(__wasm_simd128__)
+    // nrc == 2 (type_traits nrows = 2 on wasm, as on arm64 i8mm): a 2x2
+    // tile of two weight rows (vx, vx + bx) against two activation
+    // columns (vy, vy + by), results at s[0], s[1] and s[bs], s[bs + 1].
+    // This body evaluates the four dots one by one; the native kernel a
+    // transpiler substitutes shares the loads across the tile.
+    if (nrc == 2) {
+        const uint8_t * x1 = (const uint8_t *) vx + bx;
+        const uint8_t * y1 = (const uint8_t *) vy + by;
+        ggml_vec_dot_q5_K_q8_K_generic(n, s,          0, vx, 0, vy, 0, 1);
+        ggml_vec_dot_q5_K_q8_K_generic(n, s + 1,      0, x1, 0, vy, 0, 1);
+        ggml_vec_dot_q5_K_q8_K_generic(n, s + bs,     0, vx, 0, y1, 0, 1);
+        ggml_vec_dot_q5_K_q8_K_generic(n, s + bs + 1, 0, x1, 0, y1, 0, 1);
+        return;
+    }
+    assert(nrc == 1 || nrc == 2);
+#else
     assert(nrc == 1);
+#endif
     UNUSED(nrc);
     UNUSED(bx);
     UNUSED(by);
