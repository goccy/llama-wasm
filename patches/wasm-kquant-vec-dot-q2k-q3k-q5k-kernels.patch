+// Exported out of line so a wasm-to-native transpiler can swap the body
+// for a native kernel (the dbg_* convention of the q8_0 repack GEMM).
+// type_traits_cpu gives Q5_K nrows = 2 on wasm (as on arm64 i8mm), so the
+// body also takes the 2x2 tile: two weight rows (vx, vx + bx) against two
+// activation columns (vy, vy + by), results at s[0], s[1] and s[bs],
+// s[bs + 1]. This body evaluates the four dots one by one; the native
+// kernel a transpiler substitutes shares the loads across the tile.
+__attribute__((noinline, export_name("dbg_vec_dot_q5_K_q8_K")))
 void ggml_vec_dot_q5_K_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy,  size_t by, int nrc) {
     assert(n % QK_K == 0);
+    if (nrc == 2) {
+        const uint8_t * x1 = (const uint8_t *) vx + bx;
+        const uint8_t * y1 = (const uint8_t *) vy + by;
+        ggml_vec_dot_q5_K_q8_K(n, s,          0, vx, 0, vy, 0, 1);
+        ggml_vec_dot_q5_K_q8_K(n, s + 1,      0, x1, 0, vy, 0, 1);
+        ggml_vec_dot_q5_K_q8_K(n, s + bs,     0, vx, 0, y1, 0, 1);
+        ggml_vec_dot_q5_K_q8_K(n, s + bs + 1, 0, x1, 0, y1, 0, 1);
+        return;
+    }
     assert(nrc == 1);
     UNUSED(nrc);
     UNUSED(bx);
